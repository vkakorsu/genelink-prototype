{
  "name": "genelink-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:ci": "vitest run",
    "dry-run": "tsx scripts/dry-run.ts",
    "lint": "eslint",
    "a11y": "node scripts/a11y-sweep.mjs",
